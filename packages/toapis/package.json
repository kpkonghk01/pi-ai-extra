{
  "name": "@hk01/pi-ai-extra-toapis",
  "version": "0.1.0",
  "description": "ToAPIs provider adapters for @earendil-works/pi-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hk01/pi-ai-extra-internal": "workspace:*"
  }
}
