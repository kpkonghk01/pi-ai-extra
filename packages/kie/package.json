{
  "name": "@hk01/pi-ai-extra-kie",
  "version": "0.6.0",
  "description": "KIE image helper (Grok Imagine, GPT Image 2, Nano Banana 2.1) and a pi-ai chat provider (Codex, Claude) with image models, a live model list and the chat kit's traits",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pi-ai": {
      "import": {
        "types": "./dist/pi-ai.d.mts",
        "default": "./dist/pi-ai.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/pi-ai.cjs",
    "!dist/pi-ai.cjs.map",
    "!dist/pi-ai.d.cts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@hk01/pi-ai-extra-internal": "workspace:*"
  }
}
