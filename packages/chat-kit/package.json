{
  "name": "@hk01/pi-ai-extra-chat-kit",
  "version": "0.2.0",
  "description": "Server-side chat kit on pi-ai: runs one chat turn the same way on Gemini, OpenRouter, KIE and ToAPIs (documents, response schema, safety blocks, usage and cost) and lists each provider's live models",
  "license": "UNLICENSED",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit -p .",
    "test": "pnpm --filter \"@hk01/pi-ai-extra-chat-kit^...\" run build && node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@hk01/pi-ai-extra-google": ">=0.5.0 <1.0.0",
    "@hk01/pi-ai-extra-kie": ">=0.4.0 <1.0.0",
    "@hk01/pi-ai-extra-toapis": ">=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@hk01/pi-ai-extra-google": "workspace:*",
    "@hk01/pi-ai-extra-internal": "workspace:*",
    "@hk01/pi-ai-extra-kie": "workspace:*",
    "@hk01/pi-ai-extra-toapis": "workspace:*"
  }
}
