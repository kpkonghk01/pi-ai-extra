{
  // Type-checks files/ as they compile inside InfoCard: its compiler options (non-strict,
  // TypeScript 5.8 defaults made explicit, react-jsx) against the packages' published
  // declarations (dist/*.d.mts, so run `pnpm run build` first). Not part of the files to copy
  // into the app.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    // Lets files/ resolve the app's own unchanged modules to stand-ins in typecheck/app.
    "rootDirs": ["files", "typecheck/app"],
    "paths": {
      "@hk01/pi-ai-extra-kie": ["../../../packages/kie/dist/index.d.mts"],
      "@hk01/pi-ai-extra-toapis": ["../../../packages/toapis/dist/index.d.mts"],
      "@hk01/pi-ai-extra-google": ["../../../packages/google/dist/index.d.mts"],
      // These files target image-kit 0.1; 0.2 replaced its static model API.
      "@hk01/pi-ai-extra-image-kit": ["./typecheck/image-kit-v0.1/index.d.ts"],
      "@hk01/pi-ai-extra-image-kit/server": ["./typecheck/image-kit-v0.1/server.d.ts"],
      "@hk01/pi-ai-extra-image-kit/browser": ["./typecheck/image-kit-v0.1/browser.d.ts"],
      "@hk01/pi-ai-extra-image-kit/react": ["./typecheck/image-kit-v0.1/react.d.ts"],
      // Real React types, installed for the image kit.
      "react": ["../../../packages/image-kit/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../../packages/image-kit/node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["files/**/*.ts", "files/**/*.tsx", "typecheck/**/*.ts", "typecheck/**/*.tsx"]
}
