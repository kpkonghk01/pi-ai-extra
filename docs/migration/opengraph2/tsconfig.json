{
  // Type-checks files/ as they compile inside opengraph2: its compiler options (non-strict,
  // TypeScript 5.8 defaults made explicit) against the packages' published declarations
  // (dist/*.d.mts, so run `pnpm run build` first). Not part of the files to copy into the app.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "paths": {
      "@hk01/pi-ai-extra-kie": ["../../../packages/kie/dist/index.d.mts"],
      "@hk01/pi-ai-extra-toapis": ["../../../packages/toapis/dist/index.d.mts"],
      "@hk01/pi-ai-extra-google": ["../../../packages/google/dist/index.d.mts"],
      "@hk01/pi-ai-extra-image-kit": ["../../../packages/image-kit/dist/index.d.mts"],
      "@hk01/pi-ai-extra-image-kit/server": ["../../../packages/image-kit/dist/server.d.mts"]
    }
  },
  "include": ["files/**/*.ts", "typecheck/**/*.d.ts"]
}
