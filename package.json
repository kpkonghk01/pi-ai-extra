{
  "name": "pi-ai-extra",
  "version": "0.1.0",
  "private": true,
  "description": "Registry-free pnpm workspace for KIE, ToAPIs and Gemini image/chat extensions to pi-ai",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "check": "pnpm --recursive --workspace-concurrency=1 run check && pnpm run check:docs",
    "check:docs": "pnpm --filter \"./packages/*\" run build && tsc --noEmit -p docs/migration/og-master",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "clean": "pnpm --recursive run clean",
    "pack:kie": "pnpm --filter @hk01/pi-ai-extra-kie pack --pack-destination ./release-artifacts",
    "pack:toapis": "pnpm --filter @hk01/pi-ai-extra-toapis pack --pack-destination ./release-artifacts",
    "pack:google": "pnpm --filter @hk01/pi-ai-extra-google pack --pack-destination ./release-artifacts",
    "pack:openrouter": "pnpm --filter @hk01/pi-ai-extra-openrouter pack --pack-destination ./release-artifacts",
    "pack:image-kit": "pnpm --filter @hk01/pi-ai-extra-image-kit pack --pack-destination ./release-artifacts",
    "pack:chat-kit": "pnpm --filter @hk01/pi-ai-extra-chat-kit pack --pack-destination ./release-artifacts",
    "playground": "pnpm --filter \"./packages/*\" run build && pnpm --filter @hk01/pi-ai-extra-playground run start"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
